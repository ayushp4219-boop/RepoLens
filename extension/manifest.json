{
  "manifest_version": 3,
  "name": "RepoSage - GitHub AI Assistant",
  "version": "1.0.0",
  "description": "Grounded AI codebase assistant directly on GitHub repositories with exact file & line citations.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "RepoSage Assistant",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://github.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*"],
      "css": ["styles/sidebar.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
