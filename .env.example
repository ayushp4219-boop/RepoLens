# An OpenAI-compatible endpoint serving a Gemma instruct model.
GEMMA_API_URL=https://your-provider.example/v1/chat/completions
GEMMA_API_KEY=replace-with-your-server-side-key
GEMMA_MODEL=gemma-3-27b-it

# Optional: lock CORS to your unpacked/installed extension ID.
# ALLOWED_ORIGIN=chrome-extension://your-extension-id
