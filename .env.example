# RepoSage Environment Configuration

# JarvisLabs Cloud AI Settings (Multi-Model LLM with Automatic Fallback)
JARVISLABS_API_KEY=your_api_key_here
JARVISLABS_BASE_URL=https://models.jarvislabs.net/v1
REPOSAGE_MODEL_ORDER=gemma-4-31b-it,deepseek-v4.1-flash-1017,glm-5.3-flash
REPOSAGE_LLM_PROVIDER=jarvislabs
REPOSAGE_LLM_TIMEOUT=18

# Local Ollama Settings (Kept for dense code embeddings)
OLLAMA_BASE_URL=http://localhost:11434
REPOSAGE_CHAT_MODEL=qwen2.5-coder
REPOSAGE_EMBEDDING_MODEL=nomic-embed-text
REPOSAGE_EMBEDDING_DIM=768

# Storage Settings
REPOSAGE_STORAGE_BACKEND=sqlite
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reposage
